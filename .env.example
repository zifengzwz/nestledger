# Optional local configuration. Export manually with:
# set -a; source .env; set +a
#
# Environment profile:
#   test       -> https://127.0.0.1:8443, loopback only, self-signed certificate
#   production -> https://xxx.com:8001 (replace xxx.com with your domain), public bind, certificate supplied separately
# Leave APP_PORT/APP_BIND/APP_ORIGIN unset to use the profile defaults.
APP_ENV=test
# APP_PORT=8443
# APP_BIND=127.0.0.1
# APP_ORIGIN=https://127.0.0.1:8443

MONGO_HOST=127.0.0.1
MONGO_PORT=27028
MONGO_DATABASE=nestledger_dev
# Database credentials. Generate with: openssl rand -hex 24
# Keep the application user limited to MONGO_DATABASE; MONGO_AUTH_SOURCE is where it was created.
# The one-time bootstrap admin (MONGO_ADMIN_USERNAME/MONGO_ADMIN_PASSWORD) is not stored here.
MONGO_USERNAME=nestledger_app
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=nestledger_dev
REDIS_HOST=127.0.0.1
REDIS_PORT=6389
REDIS_DATABASE=0
REDIS_PASSWORD=
# TLS is on by default. The test profile generates a self-signed certificate;
# production requires the operator-supplied certificate below.
APP_TLS=true
COOKIE_SECURE=true
# Production only: absolute paths to the certificate chain and private key.
# TLS_CERT_FILE=/etc/nestledger/tls/fullchain.pem
# TLS_KEY_FILE=/etc/nestledger/tls/privkey.pem
# Required for SMS, registration and changing the bound phone. Keep real values out of Git.
# Generate the local HMAC secret with: openssl rand -hex 32
SMS_HMAC_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
ALIYUN_SMS_PHONE_CHANGE_TEMPLATE_CODE=
ALIYUN_SMS_RESET_PASSWORD_TEMPLATE_CODE=
